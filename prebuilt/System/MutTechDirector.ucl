Mutator=(ClassName=MutTechDirector.MutTechDirector,ConfigMenuClassName=MutTechDirector.MutTechDirectorConfig,GroupName=MutTechDirector,IconMaterialName=MutatorArt.nosym,FriendlyName=MutTechDirector.MutTechDirector.FriendlyName,Description=MutTechDirector.MutTechDirector.Description,FriendlyName=MutTechDirector.MutTechDirector.FriendlyName,FallbackName="Tournament Technical Director",FallbackDesc="Turns one player per team into the Tournament Technical Director: a remote broadcast operator with a locked fighter feed, tactical zoom, nanite healing and nine configurable transmat abilities. Press N to enter (5 second delay) or leave instantly. Works in any TeamGame-derived gametype.")
